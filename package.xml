<?xml version="1.0"?>
<package format="3">
  <name>suas_seed_case_tracking</name>
  <version>0.1.0</version>
  <description>Pylon Basler ace camera wrapper and seed case tracking for SUAS</description>
  <maintainer email="mohammad.wasil@h-brs.de">Mohammad Wasil</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>pylon_ros2_camera_interfaces</depend>
  <depend>std_srvs</depend>
  <depend>camera_info_manager</depend>
  <depend>image_transport</depend>
  <depend>image_geometry</depend>
  <depend>cv_bridge</depend>
  <depend>opencv2</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
